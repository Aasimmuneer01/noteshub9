{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and account information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "superadmin", "moderator"] },
        "isPremium": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Educational resource (PDF, etc.)",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "category": { "type": "string" },
        "views": { "type": "number" }
      },
      "required": ["title", "url"]
    },
    "Analytics": {
      "title": "Analytics",
      "description": "System analytics for AI support",
      "type": "object",
      "properties": {
        "totalEmailsReceived": { "type": "number" },
        "totalAIRepliesSent": { "type": "number" },
        "failedReplies": { "type": "number" },
        "lastReceivedEmail": { "type": "string", "format": "date-time" },
        "lastReplyTime": { "type": "string", "format": "date-time" }
      }
    },
    "EmailLog": {
      "title": "EmailLog",
      "description": "Log of email processing",
      "type": "object",
      "properties": {
        "emailId": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "failed", "pending"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "error": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User documents"
    },
    "resources/{resourceId}": {
      "schema": "Resource",
      "description": "Resource documents"
    },
    "analytics/summary": {
      "schema": "Analytics",
      "description": "System analytics summary"
    },
    "emailLogs/{logId}": {
      "schema": "EmailLog",
      "description": "Individual email processing logs"
    }
  }
}
